#!/bin/sh
# Ruijie RG-BE72 Pro (U-Boot mod) 网口映射（board.d，排序在 02_network 之后执行）
. /lib/functions.sh
. /lib/functions/uci-defaults.sh

board_config_update
case "$(board_name)" in
ruijie,rg-be72-pro|ruijie,rg-be72-pro-mod)
	ucidef_set_interfaces_lan_wan "lan1 lan2 lan3 lan4 eth2.2 eth1" "eth2.1"
	;;
esac
board_config_flush

exit 0
