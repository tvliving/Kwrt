# Kwrt mediatek/filogic —— 仅 PHILIPS HY3000（MT7981B + eMMC）
# 机型方案：与 tvliving/lede 的 philips_hy3000 一致（内核 FIT + 独立 rootfs 分区 + sysupgrade-tar）
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y

# 只编译本机型（覆盖 common 的 TARGET_ALL_PROFILES=y）
# CONFIG_TARGET_ALL_PROFILES is not set
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_philips_hy3000=y

# HY3000 为 8GB eMMC，rootfs 独立分区，沿用 Kwrt 默认 rootfs 体积（common 已设 1004M）

# iStore 市场
CONFIG_PACKAGE_luci-app-store=y
