# Kwrt mediatek/filogic —— 从 tvliving/lede 移植的 15 个 MT798x 机型（openwrt-25.12 上游没有）
# 机型方案与 lede master 一致：NAND/UBI 机型 sysupgrade-tar、eMMC 机型 emmc 分区方案、
# 7DR7299 fitblk itb；全部不产 preloader/fip/gpt 引导工件。
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y

# 只编译本列表机型（覆盖 common 的 TARGET_ALL_PROFILES）
# CONFIG_TARGET_ALL_PROFILES is not set
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cetron_ct3003-mod=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_clx_s20l=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cmcc_a10-mod=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cmcc_rax3000me-emmc=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cmcc_rax3000me-nand=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cmcc_xr30-emmc=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cmcc_xr30-nand=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cudy_tr3000-mod=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_fzs_5gcpe-p3=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_hf_m7986r1-emmc=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_hf_m7986r1-nand=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_huasifei_ws3006=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_huasifei_ws3009=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_jdcloud_re-cs-05=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_tplink_tl-7dr7299-v1=y

# iStore 市场（软件中心 + 首页）——包由 devices/common/istore-zh.sh 树内 vendor
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-app-quickstart=y

# 简体中文语言包（luci-i18n-*-zh-cn 由 istore-zh.sh 打开生成，workflow 里再全量枚举选入）
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# 主题：vantage（common 已设 luci-theme-vantage=y，Kwrt 不带 argon）
