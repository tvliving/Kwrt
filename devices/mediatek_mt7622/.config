
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_mt7622=y

CONFIG_TARGET_DEVICE_mediatek_mt7622_DEVICE_dlink_eagle-pro-ai-m32-a1=n
CONFIG_TARGET_DEVICE_mediatek_mt7622_DEVICE_dlink_eagle-pro-ai-r32-a1=n
CONFIG_TARGET_DEVICE_mediatek_mt7622_DEVICE_elecom_wrc-x3200gst3=n



# PassWall 仅保留 Xray + SingBox（覆盖 common 的全量组件）
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Server is not set

# 本 target 大量机型为 16MB/32MB 闪存，passwall 全家桶让 rootfs 达 45~53MB，
# check-size 超分区的机型会让整个 target 构建失败（run 43149113383/43149118727/
# 43149085475/43149123169）→ 此 target 不装 passwall
# CONFIG_PACKAGE_luci-app-passwall is not set

