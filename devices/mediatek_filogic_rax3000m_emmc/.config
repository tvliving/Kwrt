# Kwrt mediatek/filogic —— CMCC RAX3000M（eMMC 版）
# 走上游官方 cmcc_rax3000m 设备定义：DEVICE_DTS_OVERLAY 同时带
#   mt7981b-cmcc-rax3000m-emmc / mt7981b-cmcc-rax3000m-nand 两套 overlay，
#   IMAGES = sysupgrade.itb（FIT kernel+外部 rootfs），引导链走 eMMC GPT + preloader/fip。
# 注意：本机型**不套** devices/mediatek_filogic_rax3000m_256m 那套 NAND 硬改
#      （扩 ubi 到 250.5MB + platform.sh 改 nand_do_upgrade），那套只适用于硬改 NAND 机器。
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y

# 只编译本机型（覆盖 common 的 TARGET_ALL_PROFILES=y）
# CONFIG_TARGET_ALL_PROFILES is not set
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cmcc_rax3000m=y

# eMMC 8G，rootfs 放宽到 256M（上游 IMAGE_SIZE = 64 + ROOTFS_PARTSIZE；
# 默认 104M 装完 Kwrt 全套+iStore 后升级空间偏紧）
CONFIG_TARGET_ROOTFS_PARTSIZE=256

# iStore 市场（软件中心）——包由 devices/common/istore-zh.sh 树内 vendor
CONFIG_PACKAGE_luci-app-store=y

# 简体中文语言包（luci-i18n-*-zh-cn 由 istore-zh.sh 打开生成，workflow 里再全量枚举选入）
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
