
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq50xx=y

# rootfs 62.7MB 超过 cmcc_mr3000d/cmcc_pz-l8(57.6MB)、elecom_wrc-x3000gs2(50.5MB) 的分区
# （run 43149095040）→ passwall 仅保留 Xray + SingBox
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Server is not set


# ---- run 43161076272：elecom_wrc-x3000gs2 的 factory.bin 53.2MB 超其 50.6MB
# 分区（passwall 裁剪后 rootfs 仍装不下 factory 首刷镜像）→ 排除该机型
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_elecom_wrc-x3000gs2=n
