# Kwrt mediatek/filogic —— CMCC RAX3000M / XR30（NAND 硬改 256M Flash）
# 方案移植自 ReddotCleaner/rax3000m-256m-cloud-build：
#   ubi 分区由 114MB（0x7200000）扩到 250.5MB（0xFA80000），其余沿用 openwrt 25.12 原生
#   cmcc_rax3000m 的 FIT（kernel+rootfs）+ UBI 启动方式，不替换 preloader/fip。
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y

# 只编译本机型（覆盖 common 的 TARGET_ALL_PROFILES=y）
# CONFIG_TARGET_ALL_PROFILES is not set
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cmcc_rax3000m_nand=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cmcc_xr30_nand=y

# iStore 市场（软件中心 + 首页）——包由 devices/common/istore-zh.sh 树内 vendor
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-app-quickstart=y

# 简体中文语言包（luci-i18n-*-zh-cn 由 istore-zh.sh 打开生成，workflow 里再全量枚举选入）
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
