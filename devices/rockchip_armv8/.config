
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y

CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_radxa_rock-pi-4a=n
CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_radxa_cm3-io=n
CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_radxa_rock-pi-e=n
CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_radxa_rock-pi-e-v3=n
CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_wxy_oec-turbo-4g=n

CONFIG_TARGET_KERNEL_PARTSIZE=32

# iStore 市场（本 target 全部机型闪存 ≥128M 或 SD/eMMC 启动）
CONFIG_PACKAGE_luci-app-store=y
