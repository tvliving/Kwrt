# Kwrt mediatek/filogic —— lede 支持但 Kwrt 未覆盖的机型（2026-11-18 对比结果）
#
# 对比口径：tvliving/lede master 的 filogic 68 台 vs openwrt-25.12 上游 182 台
# + 本仓库已移植（mt798x_other 15 / ikuai 3 / hy3000 1 / rax3000m 2 / tr3000-512 1 /
# bt-r320 1）。lede 独有 32 台，其中 20 台已移植，10 台 25.12 已有同硬件 profile，
# 真实缺口只剩下面 2 台：
#   - imou_lc-hx3001   IMOU LC-HX3001      mt7981b  NAND+UBI   sysupgrade-tar
#   - tenda_be12-pro   Tenda BE12 Pro      mt7987a  NAND+UBI   tenda 双镜像头 + tar
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y

# 只编译本列表机型（覆盖 common 的 TARGET_ALL_PROFILES）
# CONFIG_TARGET_ALL_PROFILES is not set
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_imou_lc-hx3001=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_tenda_be12-pro=y
# TP-Link WMA301（immortalwrt-mt798x-6.6 移植，4 个 profile）
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_tplink_wma301=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_tplink_wma301-stock=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_tplink_wma301_2.1=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_tplink_wma301-ubootmod=y

# iStore 市场（软件中心 + 首页）——包由 devices/common/istore-zh.sh 树内 vendor
CONFIG_PACKAGE_luci-app-store=y

# 默认主题：luci-theme-vantage（https://github.com/anothaDev/luci-theme-vantage）
CONFIG_PACKAGE_luci-theme-vantage=y

# 简体中文语言包（luci-i18n-*-zh-cn 由 istore-zh.sh 打开生成，workflow 里再全量枚举选入）
CONFIG_LUCI_LANG_zh_Hans=y
