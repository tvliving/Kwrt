
CONFIG_TARGET_ath79=y
CONFIG_TARGET_ath79_nand=y

CONFIG_TARGET_DEVICE_ath79_nand_DEVICE_meraki_mr18=n

CONFIG_KERNEL_DEBUG_INFO_REDUCED=y
CONFIG_KERNEL_DEBUG_INFO_BTF=n
CONFIG_PACKAGE_vmlinux-btf=m

# 本 target 多为 16MB NOR 机型（gl-ar750s-nor / gl-ar300m-nor / r6100 等），
# 全局 passwall 全家桶会让 rootfs 涨到 47MB，镜像超分区被删、target/linux install 失败
# （run 43149081304、44637030107）→ 此 target 不装 passwall
# CONFIG_PACKAGE_luci-app-passwall is not set







