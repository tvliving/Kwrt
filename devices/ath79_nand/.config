
CONFIG_TARGET_ath79=y
CONFIG_TARGET_ath79_nand=y

CONFIG_TARGET_DEVICE_ath79_nand_DEVICE_meraki_mr18=n

# 本 target 多为 16MB NOR 机型（gl-ar750s-nor / gl-ar300m-nor / r6100 等），
# 全局 passwall 全家桶会让 rootfs 涨到 47MB，导致 factory 镜像超分区失败
# （run 43149081304）→ 此 target 不装 passwall
# CONFIG_PACKAGE_luci-app-passwall is not set

