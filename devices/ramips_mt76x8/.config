# Kwrt ramips/mt76x8 —— 全机型
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt76x8=y

# 本 target 大量机型为 16MB/32MB 闪存，passwall 全家桶让 rootfs 达 45~53MB，
# check-size 超分区的机型会让整个 target 构建失败（run 43149113383/43149118727/
# 43149085475/43149123169）→ 此 target 不装 passwall
# CONFIG_PACKAGE_luci-app-passwall is not set


# ---- check-size 超分区机型排除（run 43173557669 实测：镜像 12.5MiB 超以下
# 机型分区上限 ~7.6MiB，一台失败会拖垮整个 target）----
CONFIG_TARGET_DEVICE_ramips_mt76x8_DEVICE_7links_wlr-1230=n
CONFIG_TARGET_DEVICE_ramips_mt76x8_DEVICE_7links_wlr-1240=n
CONFIG_TARGET_DEVICE_ramips_mt76x8_DEVICE_alfa-network_awusfree1=n
CONFIG_TARGET_DEVICE_ramips_mt76x8_DEVICE_asus_rt-n12-vp-b1=n
CONFIG_TARGET_DEVICE_ramips_mt76x8_DEVICE_comfast_cf-wr617ac=n
CONFIG_TARGET_DEVICE_ramips_mt76x8_DEVICE_comfast_cf-wr758ac-v1=n
CONFIG_TARGET_DEVICE_ramips_mt76x8_DEVICE_comfast_cf-wr758ac-v2=n
CONFIG_TARGET_DEVICE_ramips_mt76x8_DEVICE_cudy_re1200-outdoor-v1=n
CONFIG_TARGET_DEVICE_ramips_mt76x8_DEVICE_cudy_wr1000=n
CONFIG_TARGET_DEVICE_ramips_mt76x8_DEVICE_cudy_wr300-v1=n
CONFIG_TARGET_DEVICE_ramips_mt76x8_DEVICE_dlink_dap-1325-a1=n
