# Kwrt mediatek/filogic —— 仅 Cudy TR3000 512MB 硬改版（MT7981 + NAND，mod-490 布局）
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y

# 只编译本机型（覆盖 common 的 TARGET_ALL_PROFILES=y）
# CONFIG_TARGET_ALL_PROFILES is not set
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cudy_tr3000-512mb-v1=y

# 512MB NAND：UBI 分区约 505MiB，rootfs 取 160M，其余自动作为 rootfs_data 存储空间
CONFIG_TARGET_ROOTFS_PARTSIZE=160
