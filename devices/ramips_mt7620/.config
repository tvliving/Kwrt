# Kwrt ramips/mt7620 —— 全机型
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7620=y

# 本 target 大量机型为 16MB/32MB 闪存，passwall 全家桶让 rootfs 达 45~53MB，
# check-size 超分区的机型会让整个 target 构建失败（run 43149113383/43149118727/
# 43149085475/43149123169）→ 此 target 不装 passwall
# CONFIG_PACKAGE_luci-app-passwall is not set


# ---- check-size 超分区机型排除（run 43173542508 实测：镜像 13.56MiB 超以下
# 机型分区上限 6.6~7.75MiB，一台失败会拖垮整个 target）----
CONFIG_TARGET_DEVICE_ramips_mt7620_DEVICE_aigale_ai-br100=n
CONFIG_TARGET_DEVICE_ramips_mt7620_DEVICE_ampedwireless_b1200ex=n
CONFIG_TARGET_DEVICE_ramips_mt7620_DEVICE_asus_rp-n53=n
CONFIG_TARGET_DEVICE_ramips_mt7620_DEVICE_buffalo_whr-300hp2=n
CONFIG_TARGET_DEVICE_ramips_mt7620_DEVICE_buffalo_whr-600d=n
CONFIG_TARGET_DEVICE_ramips_mt7620_DEVICE_buffalo_wmr-300=n
CONFIG_TARGET_DEVICE_ramips_mt7620_DEVICE_devolo_rac=n
CONFIG_TARGET_DEVICE_ramips_mt7620_DEVICE_dlink_dch-m225=n
CONFIG_TARGET_DEVICE_ramips_mt7620_DEVICE_dlink_dir-806a-b1=n
CONFIG_TARGET_DEVICE_ramips_mt7620_DEVICE_dlink_dir-810l=n
