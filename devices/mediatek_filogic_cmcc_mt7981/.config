# Kwrt mediatek/filogic —— CMCC RAX3000M / XR30（NAND + eMMC 四机型）
# 机型全部从 tvliving/lede 移植（openwrt-25.12 上游没有这四个设备）：
#   cmcc_rax3000m-nand   NAND 128M：UBI 布局，产物 factory.bin + sysupgrade.bin
#   cmcc_rax3000m-emmc   eMMC：kernel/rootfs 独立分区，产物只有 sysupgrade.bin
#   cmcc_xr30-nand       NAND 128M（U-Boot mod）：同 rax3000m-nand
#   cmcc_xr30-emmc       eMMC：同 rax3000m-emmc
# 不产 preloader / fip / gpt 等引导工件，沿用机器现有 U-Boot。
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y

# 只编译本列表机型（覆盖 common 的 TARGET_ALL_PROFILES）
# CONFIG_TARGET_ALL_PROFILES is not set
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cmcc_rax3000m-nand=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cmcc_rax3000m-emmc=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cmcc_xr30-nand=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cmcc_xr30-emmc=y

# iStore 市场（软件中心）——包由 devices/common/istore-zh.sh 树内 vendor，
# 界面语言由 files/etc/uci-defaults/zzz-zh-cn 强制 zh-cn
CONFIG_PACKAGE_luci-app-store=y

# 简体中文语言包（luci-i18n-*-zh-cn 由 istore-zh.sh 打开生成，workflow 里再全量枚举选入）
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y