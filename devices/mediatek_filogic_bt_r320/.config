# Kwrt mediatek/filogic —— 仅 Globitel BT-R320（MT7981B + MT7531AE + eMMC）
# 机型方案：与 tvliving/lede 的 globitel_bt-r320 一致
#   （内核 FIT 独立分区 + rootfs 独立分区 + sysupgrade-tar，root=PARTLABEL=rootfs）
# 注：openwrt-25.12 上游自带这个机型，但用的是 fitblk / sysupgrade.itb 新方案，
#     需要先刷 preloader/fip/gpt；devices/mediatek_filogic_bt_r320/diy.sh
#     会把它改回「沿用原厂 U-Boot」的 tar 方案。
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y

# 只编译本机型（覆盖 common 的 TARGET_ALL_PROFILES=y）
# CONFIG_TARGET_ALL_PROFILES is not set
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_globitel_bt-r320=y

# BT-R320 为 128G eMMC，rootfs 独立分区，沿用 Kwrt 默认 rootfs 体积（common 已设 1004M）

# iStore 市场（软件中心 + 首页）——包由 devices/common/istore-zh.sh 树内 vendor
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-app-quickstart=y

# 简体中文语言包（luci-i18n-*-zh-cn 由 istore-zh.sh 打开生成，workflow 里再全量枚举选入）
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
